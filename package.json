{
  "name": "pattern-library",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "dev:restart": "pids=$(lsof -ti:3000,3001,3002 2>/dev/null); [ -n \"$pids\" ] && kill -9 $pids 2>/dev/null; rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "verify:themes": "npx tsx scripts/verify-gallery-themes.ts"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.61.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
